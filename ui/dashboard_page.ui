<?xml version="1.0"?>
<interface>
  <object class="GtkVBox" id="dashboard_page">
    <property name="spacing">5</property>
    <property name="border_width">6</property>
    <child>
      <object class="GtkHBox" id="stats_hbox">
        <property name="homogeneous">True</property>
        <property name="spacing">5</property>
      </object>
      <packing>
        <property name="expand">False</property>
        <property name="fill">False</property>
      </packing>
    </child>
    <child>
      <object class="GtkEventBox" id="heat_eb">
        <child>
          <object class="GtkFrame" id="heat_frame">
            <property name="shadow_type">GTK_SHADOW_OUT</property>
            <child>
              <object class="GtkVBox" id="heat_vbox">
                <property name="spacing">4</property>
                <property name="border_width">8</property>
                <child>
                  <object class="GtkHBox" id="heat_hdr">
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkLabel" id="heat_title_lbl">
                        <property name="label">阅读热力图</property>
                        <property name="xalign">0</property>
                        <property name="yalign">0.5</property>
                      </object>
                      <packing>
                        <property name="expand">True</property>
                        <property name="fill">True</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkEventBox" id="yr_eb">
                        <child>
                          <object class="GtkHBox" id="yr_hbox">
                            <property name="spacing">20</property>
                            <child>
                              <object class="GtkButton" id="yr_prev">
                                <property name="label">&lt;</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="heat_year_lbl">
                                <property name="width_request">180</property>
                                <property name="xalign">0.5</property>
                                <property name="yalign">0.5</property>
                                <property name="xpad">10</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="yr_next">
                                <property name="label">&gt;</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="heat_spacer">
                        <property name="label">  </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEventBox" id="mo_eb">
                        <child>
                          <object class="GtkHBox" id="mo_hbox">
                            <property name="spacing">20</property>
                            <child>
                              <object class="GtkButton" id="mo_prev">
                                <property name="label">&lt;</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="heat_month_lbl">
                                <property name="width_request">120</property>
                                <property name="xalign">0.5</property>
                                <property name="yalign">0.5</property>
                                <property name="xpad">10</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="mo_next">
                                <property name="label">&gt;</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkHBox" id="heat_content">
                    <property name="spacing">14</property>
                    <child>
                      <object class="GtkDrawingArea" id="heat_drawing_area">
                        <property name="width_request">480</property>
                        <property name="height_request">110</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkTable" id="heat_stats_grid">
                        <property name="n_rows">2</property>
                        <property name="n_columns">2</property>
                        <property name="column_spacing">16</property>
                        <property name="row_spacing">4</property>
                      </object>
                      <packing>
                        <property name="expand">True</property>
                        <property name="fill">True</property>
                      </packing>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                  </packing>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
      <packing>
        <property name="expand">False</property>
        <property name="fill">False</property>
      </packing>
    </child>
    <child>
      <object class="GtkEventBox" id="gold_eb">
        <child>
          <object class="GtkFrame" id="gold_frame">
            <property name="shadow_type">GTK_SHADOW_OUT</property>
            <child>
              <object class="GtkVBox" id="gold_vbox">
                <property name="spacing">3</property>
                <property name="border_width">8</property>
                <child>
                  <object class="GtkLabel" id="gold_title_lbl">
                    <property name="label">最爱阅读时段</property>
                    <property name="xalign">0</property>
                    <property name="yalign">0.5</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="gold_sub_lbl">
                    <property name="label">最常在 18:00 - 21:00 分布</property>
                    <property name="xalign">0</property>
                    <property name="yalign">0.5</property>
                  </object>
                </child>
                <child>
                  <object class="GtkDrawingArea" id="bar24_da">
                    <property name="height_request">200</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
      <packing>
        <property name="expand">False</property>
        <property name="fill">False</property>
      </packing>
    </child>
    <child>
      <object class="GtkEventBox" id="hbar_eb">
        <child>
          <object class="GtkFrame" id="hbar_frame">
            <property name="shadow_type">GTK_SHADOW_OUT</property>
            <child>
              <object class="GtkVBox" id="hbar_vbox">
                <property name="spacing">3</property>
                <property name="border_width">8</property>
                <child>
                  <object class="GtkLabel" id="hbar_title_lbl">
                    <property name="label">近7日阅读趋势</property>
                    <property name="xalign">0</property>
                    <property name="yalign">0.5</property>
                  </object>
                </child>
                <child>
                  <object class="GtkDrawingArea" id="hbar_da">
                    <property name="height_request">220</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
      <packing>
        <property name="expand">False</property>
        <property name="fill">False</property>
      </packing>
    </child>
  </object>
</interface>